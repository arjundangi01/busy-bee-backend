PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/busy_bee?schema=public"
SESSION_TOKEN_SECRET="dev-secret-change-me"
ANTHROPIC_API_KEY="sk-ant-..."

# DD-003 Paywall/Upgrade — optional until real RevenueCat account/products exist.
# The /webhooks/revenuecat route rejects all requests while this is unset.
REVENUECAT_WEBHOOK_SECRET=

# Google social login — paste the full Firebase service-account JSON as a
# single-line string (Firebase Console > Project Settings > Service Accounts
# > Generate new private key). Optional; POST /auth/google returns a clear
# 501 until this is set for real.
FIREBASE_SERVICE_ACCOUNT_JSON=
