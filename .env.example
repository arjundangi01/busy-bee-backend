PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/busy_bee?schema=public"
SESSION_TOKEN_SECRET="dev-secret-change-me"

# AI provider for POST /missions/plan — one of: openrouter (default),
# anthropic, openai. Only the selected provider's API key below is required
# at boot; the app throws a clear startup error if it's missing.
AI_PROVIDER=openrouter
# Optional — overrides the model for whichever provider is active above.
# Leave unset to use that provider's own default (openrouter: openai/gpt-oss-20b:free,
# anthropic: claude-opus-4-8, openai: gpt-4o-mini).
AI_MODEL=
OPENROUTER_API_KEY="sk-or-..."
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# DD-003 Paywall/Upgrade — optional until real RevenueCat account/products exist.
# The /webhooks/revenuecat route rejects all requests while this is unset.
REVENUECAT_WEBHOOK_SECRET=

# Google social login — paste the full Firebase service-account JSON as a
# single-line string (Firebase Console > Project Settings > Service Accounts
# > Generate new private key). Optional; POST /auth/google returns a clear
# 501 until this is set for real.
FIREBASE_SERVICE_ACCOUNT_JSON=
