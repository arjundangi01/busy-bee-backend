generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MissionStatus {
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  PENDING
  DONE
}

enum SessionEndReason {
  MISSION_COMPLETED
  EARLY_EXIT
  TIME_LIMIT_REACHED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  BILLING_ISSUE
}

enum SubscriptionProvider {
  IOS
  ANDROID
}

enum PlanTier {
  FREE
  PRO
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

// DD-003 Free/Pro limits, config-driven rather than hardcoded — one row per
// tier. A null cap means unlimited (Pro's row ships with both null). Seeded
// by this model's migration; change the row directly to change business
// limits without a code deploy.
model PlanLimits {
  id                        String   @id @default(cuid())
  tier                      PlanTier @unique
  dailySessionCap           Int?
  sessionDurationCapSeconds Int?
  updatedAt                 DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  // Nullable: Google-only accounts (authProvider GOOGLE) have no password —
  // real gap flagged since DD-001's 3.2 Sign Up/Sign In build.
  passwordHash String?
  authProvider AuthProvider @default(EMAIL)
  // Firebase's stable per-user uid — set once on first Google sign-in,
  // looked up on every subsequent one. Unique so one Firebase account can't
  // attach to two Users.
  firebaseUid  String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // 3.1 Onboarding/First-Run permission state — null means not yet asked,
  // true/false is the granted/denied-or-skipped outcome. Drives the
  // self-service Permissions section on 5.1 Settings/Account.
  backgroundExecutionGranted Boolean?
  notificationsGranted       Boolean?

  // 5.1 Settings/Account — in-app notification preferences, a different
  // layer from the OS-level grants above. Not wired to a real push-sending
  // system yet (no server-side push scheduling exists — same open item as
  // DD-002's 2.1 entry-point deferral); these just record the user's choice.
  pushNotificationsEnabled Boolean @default(true)
  eodNudgeEnabled          Boolean @default(true)

  missions     Mission[]
  subscription Subscription?
}

// 4.1 Paywall/Upgrade — absence of a row (or a non-ACTIVE status) means Free tier.
// Populated/updated by the RevenueCat webhook (see routes/webhooks); no local
// billing logic lives here, this only mirrors RevenueCat's entitlement state.
model Subscription {
  id                    String               @id @default(cuid())
  userId                String               @unique
  user                  User                 @relation(fields: [userId], references: [id])
  status                SubscriptionStatus
  provider              SubscriptionProvider
  productId             String
  originalTransactionId String?
  expiresAt             DateTime?
  autoRenewing          Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model Mission {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  title            String
  // Nullable: AI-generated missions (1.2) deliberately avoid fixed time-size
  // framing per the Product Brief's positioning — no estimate is fabricated.
  estimatedMinutes Int?
  status           MissionStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  completedAt      DateTime?

  tasks         MissionTask[]
  focusSessions FocusSession[]
}

model MissionTask {
  id               String     @id @default(cuid())
  missionId        String
  mission          Mission    @relation(fields: [missionId], references: [id])
  title            String
  order            Int
  // Nullable for the same reason as Mission.estimatedMinutes above.
  estimatedMinutes Int?
  status           TaskStatus @default(PENDING)
  completedAt      DateTime?
}

model FocusSession {
  id                  String            @id @default(cuid())
  missionId           String
  mission             Mission           @relation(fields: [missionId], references: [id])
  startedAt           DateTime          @default(now())
  endedAt             DateTime?
  elapsedSeconds      Int?
  sessionEndReason    SessionEndReason?
  blockedAttemptCount Int               @default(0)
}
