generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MissionStatus {
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  PENDING
  DONE
}

enum SessionEndReason {
  MISSION_COMPLETED
  EARLY_EXIT
  TIME_LIMIT_REACHED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  BILLING_ISSUE
}

enum SubscriptionProvider {
  IOS
  ANDROID
}

enum PlanTier {
  FREE
  PRO
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

// DD-007 Account Deletion — anomaly types logged by both the account-deletion
// routine and the RevenueCat webhook's orphan-user branch. SIGNATURE_INVALID
// is deliberately absent: the existing requireRevenueCatSecret middleware
// already rejects bad webhook secrets at the HTTP layer before a handler runs.
enum SubscriptionErrorType {
  USER_NOT_FOUND
  CANCEL_FAILED
  DUPLICATE_EVENT
  UNKNOWN_EVENT_TYPE
}

enum WorkTypeTier {
  FREE
  PRO
}

// DD-003 Free/Pro limits, config-driven rather than hardcoded — one row per
// tier. A null cap means unlimited (Pro's row ships with both null). Seeded
// by this model's migration; change the row directly to change business
// limits without a code deploy.
model PlanLimits {
  id                        String   @id @default(cuid())
  tier                      PlanTier @unique
  dailySessionCap           Int?
  sessionDurationCapSeconds Int?
  // Mission task-editing limits — separate from the two caps above (which
  // are about a single focus SESSION's cadence/length), these cap a
  // mission's own task roadmap: how many tasks it can ever have, and the
  // combined time budget across all of them. Only enforced when a task is
  // *added* past either cap — the AI's initial breakdown is never blocked
  // or told to stay under them.
  maxTasksPerMission        Int?
  maxMissionMinutes         Int?
  updatedAt                 DateTime @updatedAt
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  // Nullable: Google-only accounts (authProvider GOOGLE) have no password —
  // real gap flagged since DD-001's 3.2 Sign Up/Sign In build.
  passwordHash String?
  authProvider AuthProvider @default(EMAIL)
  // Firebase's stable per-user uid — set once on first Google sign-in,
  // looked up on every subsequent one. Unique so one Firebase account can't
  // attach to two Users.
  firebaseUid  String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // 3.1 Onboarding/First-Run permission state — null means not yet asked,
  // true/false is the granted/denied-or-skipped outcome. Drives the
  // self-service Permissions section on 5.1 Settings/Account.
  backgroundExecutionGranted Boolean?
  notificationsGranted       Boolean?

  // 5.1 Settings/Account — in-app notification preferences, a different
  // layer from the OS-level grants above. Not wired to a real push-sending
  // system yet (no server-side push scheduling exists — same open item as
  // DD-002's 2.1 entry-point deferral); these just record the user's choice.
  pushNotificationsEnabled Boolean @default(true)
  eodNudgeEnabled          Boolean @default(true)

  // DD-004 My Account — self-service profile details, editable from Settings.
  // All nullable: none are collected at sign-up, only filled in if the user
  // chooses to.
  occupation String?
  phone      String?
  age        Int?
  bio        String?

  // 5.1 Settings/Account Blocked Apps — tracks whether the one-time
  // known-defaults seed (Instagram/YouTube/X, client-determined) has already
  // run, so removed defaults never silently reappear on relaunch.
  blocklistDefaultsSeeded Boolean @default(false)

  // Bee's Hive/Focus Session blocking enforcement — the one-time just-in-time
  // permission nudge (design-artifacts/evolution/specs/06-permission-priming.md).
  // True once the nudge has been shown, regardless of skip/grant outcome —
  // after that it's reachable via 5.1 Settings only, never shown again.
  accessibilityPrimingShown Boolean @default(false)

  // Bee's Hive — the work type used for new Focus Sessions until the user
  // changes it there. Null until their first visit to the Hive (or their
  // first session, whichever comes first — see FocusSessionsHelpers.start's
  // fallback-to-first-free-type logic).
  selectedWorkTypeId String?
  selectedWorkType   WorkType? @relation(fields: [selectedWorkTypeId], references: [id])

  // Bee customization tab — Bee's Hive appearance picker. Null means the
  // default skin (BeeCharacter's own built-in colors, no row needed).
  selectedSkinId String?
  selectedSkin   BeeSkin? @relation(fields: [selectedSkinId], references: [id])

  // Bee's Hive — environment/scene customization. Null means the default
  // scene (WorkshopEnvironment's own built-in Golden Hour colors, no row
  // needed) — same "null = default" convention as selectedSkinId.
  selectedThemeId String?
  selectedTheme   HiveTheme? @relation(fields: [selectedThemeId], references: [id])

  missions            Mission[]
  subscription        Subscription?
  blockedApps         BlockedApp[]
  appUsageDaily       AppUsageDaily[]
  deviceActivityDaily DeviceActivityDaily[]
}

// 4.1 Paywall/Upgrade — absence of a row (or a non-ACTIVE status) means Free tier.
// Populated/updated by the RevenueCat webhook (see routes/webhooks); no local
// billing logic lives here, this only mirrors RevenueCat's entitlement state.
model Subscription {
  id                    String               @id @default(cuid())
  userId                String               @unique
  user                  User                 @relation(fields: [userId], references: [id])
  status                SubscriptionStatus
  provider              SubscriptionProvider
  productId             String
  originalTransactionId String?
  expiresAt             DateTime?
  autoRenewing          Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

// DD-007 Account Deletion — one row per completed deletion, written just
// before the account and its data are hard-deleted. Deliberately holds no
// personal product data (missions, tasks, etc.) — only what's needed to
// reconcile a billing dispute after the account row is gone. `email` is NOT
// unique: the same email can legitimately appear across multiple rows if a
// user re-signs-up and deletes again later.
model DeletionAudit {
  id                            String              @id @default(cuid())
  originalUserId                String
  email                         String
  revenueCatAppUserId           String?
  subscriptionStatusAtDeletion  SubscriptionStatus?
  deletedAt                     DateTime            @default(now())
}

// DD-007 Account Deletion — general-purpose log for RevenueCat webhook /
// subscription-cancellation anomalies (see SubscriptionErrorType). `context`
// carries whatever event payload/detail is relevant per anomaly type rather
// than a fixed column set, since the shape differs by `type`.
model SubscriptionErrorLog {
  id        String                @id @default(cuid())
  type      SubscriptionErrorType
  context   Json
  createdAt DateTime              @default(now())
}

// DD-007 Account Deletion — webhook event-id idempotency. RevenueCat can and
// does redeliver events; the unique constraint on eventId is what makes
// `handleRevenueCat`'s dedup check atomic (insert-or-detect-duplicate)
// instead of a separate read-then-write that could race.
model ProcessedRevenueCatEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  createdAt DateTime @default(now())
}

model Mission {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  title            String
  // The user-confirmed focus duration for this mission (seeded from the AI's
  // estimatedMinutes, adjustable before Start — see MissionsHelpers.create),
  // clamped server-side to the caller's plan cap. Nullable only for missions
  // created before this field was populated.
  estimatedMinutes Int?
  status           MissionStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  completedAt      DateTime?

  tasks         MissionTask[]
  focusSessions FocusSession[]
}

model MissionTask {
  id               String     @id @default(cuid())
  missionId        String
  mission          Mission    @relation(fields: [missionId], references: [id])
  title            String
  order            Int
  // Per-step time budget — not populated yet (the mission-level estimate on
  // Mission.estimatedMinutes is the only duration set today); reserved for
  // if/when per-step budgets become a real need.
  estimatedMinutes Int?
  status           TaskStatus @default(PENDING)
  completedAt      DateTime?

  // Insights/Data Dashboard Track 1 — set the moment this task becomes the
  // mission's active/next task (mission creation for the first task, or
  // MissionsHelpers.completeTask for every task after), so "tasks past their
  // time budget" is measured from a real timestamp rather than inferred.
  // Null for every task created before this field existed.
  startedAt DateTime?
}

// 5.1 Settings/Account Blocked Apps — a user's personal blocklist of
// installed Android apps (see mobile/src/module/settings). Enforcement is
// out of scope; this only makes the blocklist data exist and be manageable.
model BlockedApp {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  packageName String
  appName     String
  createdAt   DateTime @default(now())

  @@unique([userId, packageName])
}

model FocusSession {
  id                  String            @id @default(cuid())
  missionId           String
  mission             Mission           @relation(fields: [missionId], references: [id])
  startedAt           DateTime          @default(now())
  endedAt             DateTime?
  elapsedSeconds      Int?
  sessionEndReason    SessionEndReason?
  blockedAttemptCount Int               @default(0)

  // Bee's Hive — set at session start from the user's selectedWorkTypeId.
  // workUnitsCompleted is computed server-side at session end from real
  // elapsed time (never trusted from the client — same principle as the
  // Free-tier duration cap enforcement below it), capped at the work type's
  // totalUnits. Nullable: a session can exist with no work type assigned if
  // no WorkType rows exist yet (defensive, shouldn't happen post-seed).
  workTypeId         String?
  workType           WorkType? @relation(fields: [workTypeId], references: [id])
  workUnitsCompleted Int       @default(0)

  blockedAttemptEvents BlockedAttemptEvent[]
}

// Insights/Data Dashboard Track 1 (design-artifacts/evolution/specs/
// 10-insights-accuracy-and-distraction-detail.md) — one row per blocked
// attempt, capturing which app it was against, not just a count. Chosen over
// a flat per-app counter map so future breakdowns (timeline, multiple ranked
// apps, per-day detail) aren't blocked by today's storage shape. appName is
// resolved at query time against the user's own BlockedApp list rather than
// duplicated here.
model BlockedAttemptEvent {
  id             String       @id @default(cuid())
  focusSessionId String
  focusSession   FocusSession @relation(fields: [focusSessionId], references: [id])
  packageName    String
  occurredAt     DateTime     @default(now())
}

// Insights/Data Dashboard Track 2 (design-artifacts/evolution/specs/
// 11-insights-screen-time-and-device-activity.md) — daily aggregates only,
// computed on-device from Android's UsageStatsManager and posted once per
// day (upserted, never streamed as raw events) — less privacy-sensitive
// than a raw event log, and this data only ever needs day-level ranking/
// averaging, never per-event detail. `date` is a UTC day key (matches the
// existing `dayKey` helper's convention), not a timestamp — this is a daily
// rollup row, not an event.
model AppUsageDaily {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  date              String
  packageName       String
  appName           String
  foregroundSeconds Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, date, packageName])
}

// One row per user per day — pickups/offline-time/first-last-pickup are
// already day-level aggregates on the device itself (see the usage-stats
// native module), so there's no finer grain worth storing.
model DeviceActivityDaily {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  date           String
  pickupCount    Int
  firstPickupAt  DateTime?
  lastPickupAt   DateTime?
  offlineSeconds Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, date])
}

// Bee's Hive work-type registry (design-artifacts/evolution/specs/03-companion-work-types.md).
// Deliberately data, not code — new work types (especially Pro ones) are meant
// to be addable via a DB row, never an app release. Seeded with the two Free
// launch types by this model's own migration.
model WorkType {
  id         String       @id @default(cuid())
  // Stable identifier the client can hardcode against for known launch types
  // without depending on generated cuids — e.g. picking a specific icon set.
  key        String       @unique
  label      String
  tier       WorkTypeTier
  totalUnits Int
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())

  focusSessions   FocusSession[]
  selectedByUsers User[]
}

// Bee customization tab — Bee's Hive appearance picker. Deliberately data,
// not code, mirroring WorkType's own registry pattern above: new skins
// (especially Pro ones) are addable via a DB row, never an app release.
// Reuses WorkTypeTier for the same FREE/PRO gating concept rather than a
// duplicate enum with an identical value set.
model BeeSkin {
  id    String       @id @default(cuid())
  key   String       @unique
  label String
  tier  WorkTypeTier

  // Flat hex colors consumed directly by BeeCharacter's BeeSkin prop — no
  // client-side color derivation, the registry row is the full appearance.
  bodyPrimary   String
  bodySecondary String
  stripe        String

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  selectedByUsers User[]
}

// Bee's Hive environment/scene customization — deliberately data, not code,
// same registry pattern as BeeSkin/WorkType: new themes (especially Pro
// ones) are addable via a DB row, never an app release. Reuses WorkTypeTier
// rather than a duplicate FREE/PRO enum.
model HiveTheme {
  id    String       @id @default(cuid())
  key   String       @unique
  label String
  tier  WorkTypeTier

  // Flat hex colors consumed directly by WorkshopEnvironment's `theme`
  // prop — no client-side derivation, same precedent as BeeSkin's own
  // bodyPrimary/bodySecondary/stripe fields.
  skyTop      String
  skyBottom   String
  wallTop     String
  wallBottom  String
  floorTop    String
  floorBottom String
  lanternGlow String

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  selectedByUsers User[]
}
